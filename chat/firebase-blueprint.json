{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with display name, presence, and status details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "One-to-one conversation between two participants with real-time updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "object" },
        "pinnedBy": { "type": "array" },
        "mutedBy": { "type": "array" },
        "typingUsers": { "type": "object" },
        "wallpaper": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message including rich text, audio voice note, images, and reactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaCaption": { "type": "string" },
        "mediaDuration": { "type": "number" },
        "replyTo": { "type": "object" },
        "reactions": { "type": "object" },
        "starredBy": { "type": "array" },
        "deletedForEveryone": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["chatId", "senderId", "senderName"]
    },
    "Status": {
      "title": "Status",
      "description": "WhatsApp style 24-hour status story update",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "text": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and authenticated user profile records"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversation threads and metadata"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages within a conversation"
    },
    "/statuses/{statusId}": {
      "schema": "Status",
      "description": "Ephemeral 24-hour status updates"
    }
  }
}
